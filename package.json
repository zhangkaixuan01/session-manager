{
  "name": "session-manager",
  "version": "0.2.0",
  "description": "本地优先的 Claude Code 与 Codex 桌面会话管理器，支持会话互转、搜索预览、重命名与安全清理。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhangkaixuan01/session-manager.git"
  },
  "homepage": "https://github.com/zhangkaixuan01/session-manager#readme",
  "bugs": {
    "url": "https://github.com/zhangkaixuan01/session-manager/issues"
  },
  "author": "LAS",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build:web": "vite build",
    "build": "tauri build --no-bundle",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "tauri build",
    "dist:win": "tauri build --bundles nsis",
    "dist:mac": "tauri build --bundles dmg,app",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check:scan": "cargo run --manifest-path src-tauri/Cargo.toml --bin check-scan",
    "check:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
